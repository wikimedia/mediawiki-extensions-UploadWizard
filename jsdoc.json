{
	"opts": {
		"destination": "docs",
		"pedantic": true,
		"readme": "README",
		"recurse": true,
		"template": "node_modules/jsdoc-wmf-theme"
	},
	"plugins": [
		"node_modules/jsdoc-wmf-theme/plugins/default"
	],
	"source": {
		"include": [ "resources" ]
	},
	"templates": {
		"cleverLinks": true,
		"default": {
			"useLongnameInNav": true
		},
		"wmf": {
			"repository": "https://gerrit.wikimedia.org/g/mediawiki/extensions/UploadWizard/",
			"prefixMap": {
				"mw.": "https://doc.wikimedia.org/mediawiki-core/master/js/{type}.html",
				"mw.UploadWizard": true,
				"mw.ApiUpload": true,
				"mw.FlickrChecker": true,
				"mw.canvas": true,
				"mw.errorDialog": true,
				"mw.fileApi": true,
				"datamodel.": "https://doc.wikimedia.org/Wikibase/master/js/components/view-wikibase-data-model.md",
				"dataValues.": "https://doc.wikimedia.org/Wikibase/master/js/components/view-wikibase-data-values.md"
			},
			"linkMap": {}
		}
	}
}
